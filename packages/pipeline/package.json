{
  "name": "@ai-slop-font/pipeline",
  "version": "0.1.0",
  "description": "Ingestion: builds the font index (Google Fonts metadata + glyph metrics + attributes) and saturation signals.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
