    "metrics": "tsx src/extract-metrics.ts",
    "personality": "tsx src/seed-personality.ts",
    "synthetic": "tsx src/sample-synthetic.ts"
  },
  "dependencies": {
    "@ai-slop-font/core": "*",
    "adm-zip": "^0.5.16",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/opentype.js": "^1.3.8",
    "tsx": "^4.19.0"
  }
}
