# Brainstorming visual-companion working files
.superpowers/

# Node
node_modules/
dist/
.next/
*.log

# Generated data (regenerable via the pipeline: npm run index / metrics / synthetic).
# Everything under a data/ directory is ignored EXCEPT the small frozen bundles the
# engine imports at module load — without them a fresh clone cannot run, test or deploy.
data/
!apps/engine/data/
!apps/engine/data/*.json
!/data/
/data/*
!/data/research/
/data/research/*
!/data/research/master-v2/
/data/research/master-v2/*
!/data/research/master-v2/INDEX.md
!/data/research/master-v2/font-space.v2.json
!/data/research/master-v2/component-personality.v1.json
!/data/research/master-v2/expression-treatments.v1.json
!/data/research/master-v2/expression-compatibility.v1.json
!/data/research/master-v2/color-scene-space.v2.json
!/data/research/master-v2/material-texture-space.v2.json

# Env
.env
.env.local
.env.*
!.env.example

# Browser/session exports are credentials, even when created for local research.
**/[Cc]ookies.txt
**/*_cookies.txt
**/*-cookies.txt
**/cookies.json
**/Cookies

# Playwright MCP browser snapshots
.playwright-mcp/
*.bak

# app build artifacts (apps/web/vendor is committed — it's the static deploy bundle)
apps/**/node_modules/
apps/worker/.wrangler/
apps/web/build/

# Local blinded UI benchmark runs (screenshots + private system key)
benchmarks/ui-skills/runs/

# Local visual-research workspace and root-level QA captures. Curated references
# belong under docs/, viz/, or apps/web; raw video/frame dumps stay local.
kole-ui-guide/
.scratch/
/archetype-viewer.html
/*.png
/*.jpg
/*.jpeg

# ---- text-side (TextSlopBench) data guards ----
# External corpora are fetched locally and NEVER committed. Baumler has no license
# file and LAMP raw-text redistribution is unconfirmed, so raw corpora AND all run
# outputs stay out of this public repo. Shippable ID-only manifests + own synthetic
# fixtures live in textslopbench/manifests/ instead. See docs/textslop/DATASET_ADAPTER_PLAN.md.
textslopbench/data_raw/
textslopbench/results/
*.raw.json
*[Bb]aumler*
# ...but the Baumler *adapter code* (reads the corpus; contains no corpus text) ships:
!textslopbench/adapters/baumler.py

# Python hygiene (this repo also hosts the Python text side)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
